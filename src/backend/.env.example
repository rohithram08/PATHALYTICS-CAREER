# Backend
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (TiDB / MySQL)
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Auth - generate a long random hex string, e.g.: openssl rand -hex 64
JWT_SECRET=

# Email (Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# Chatbot / AI
GROQ_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Job search (Adzuna)
VITE_ADZUNA_APP_ID=
VITE_ADZUNA_APP_KEY=

# Dev-only: test-persona seed script (src/backend/scripts/seedTestPersonas.mjs)
# NOT required to run the app - only needed if you run that script locally.
# ALLOW_TEST_SEED and SEED_CONFIRM_DB_HOST are explicit safety confirmations,
# not secrets - see the script's header comment for the full safety model.
ALLOW_TEST_SEED=
SEED_CONFIRM_DB_HOST=
TEST_PERSONA_VERIFIED_JOBSEEKER_PASSWORD=
TEST_PERSONA_UNVERIFIED_JOBSEEKER_PASSWORD=
TEST_PERSONA_VERIFIED_RECRUITER_PASSWORD=
TEST_PERSONA_UNVERIFIED_RECRUITER_PASSWORD=
